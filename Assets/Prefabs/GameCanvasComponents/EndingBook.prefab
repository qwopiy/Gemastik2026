  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Produk 1, produk 2, produk 3. Produk demi produk kamu selesaikan dalam
    hitungan detik. <br><br>Formulir, cap, stempel. Pena. Kaca pembesar, berbagai
    macam benda kamu ambil dan gunakan tanpa ada jeda. <br><br>Bukan asal cepat.
    tangan, pikiran, dan ragamu terasa membelah menjadi 8. Mengeksekusi pengecekan
    dengan sangat efisien dan sempurna <br><br>Mungkin.. sebaiknya kamu jadi atlit
    saja. Eh.. ada ga ya atlit cabang konselor gizi?

'
  m_isRightToLeft: 0
